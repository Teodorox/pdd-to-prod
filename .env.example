# Copie para .env e ajuste. Nunca versione o .env.

AUTOMACAO_NOME=extracao_exemplo
BASE_URL=http://localhost:8000

# true = navega e extrai, mas NÃO grava a saída, não executa ação crítica e não grava estado
DRY_RUN=false

# Navegador
HEADLESS=false
# Vazio = Chromium do Playwright (pasta navegadores\ do projeto, criada pelo instalar.ps1).
# Use "msedge" ou "chrome" para o navegador instalado na máquina.
CANAL_NAVEGADOR=
TIMEOUT_MS=15000
SLOW_MO_MS=0
# STORAGE_STATE=dados/storage_state.json
# PROXY_SERVER=http://proxy.empresa:8080

# Execução
MAX_TENTATIVAS_ITEM=3
MAX_ERROS_CONSECUTIVOS=3
# falha = guarda o trace só de quem falhou | sempre = de todos (DEV/homologação; ocupa disco)
TRACE=falha

# Agendamento: scripts\agendar.ps1 instalar cria a tarefa no Agendador de Tarefas com estes horários.
# Mudou aqui? Rode o agendar.ps1 instalar de novo (como administrador).
# Dias: seg,ter,qua,qui,sex,sab,dom ou todos. Horários: HH:MM separados por vírgula.
AGENDA_DIAS=seg,ter,qua,qui,sex
AGENDA_HORARIOS=07:00
# VM desligada no horário: a tarefa roda quando a VM volta, se o atraso for até X min; acima disso, só notifica
AGENDA_TOLERANCIA_MIN=60
# Execução que passar disso é encerrada (com o navegador) e notificada
AGENDA_TIMEOUT_MIN=240

# Monitoramento central (ver docs/monitoramento). Vazio = não grava. Requer o extra banco
# MONITOR_URL=mysql+pymysql://usuario:senha@servidor:3306/monitoramento?charset=utf8mb4
MONITOR_HEARTBEAT_MIN=5

# Notificação: qualquer combinação de log,teams,email
NOTIFICAR_VIA=log
TEAMS_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_DE=
EMAIL_PARA=

# Específico do projeto de exemplo
PORTAL_USUARIO=operador
PORTAL_SENHA=troque-me
ARQUIVO_ENTRADA=dados/entrada/consultas.csv
# Pasta da saída. Em produção, normalmente a pasta de rede da área: \\servidor\area\robo
SAIDA_DIR=dados/saida
